<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-permission android:name="android.permission.INTERNET"/>
 <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
 <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
 <application
  android:theme="@style/Theme.FlowPay"
  android:label="FlowPay"
  android:icon="@mipmap/ic_launcher"
  android:roundIcon="@mipmap/ic_launcher"
  android:allowBackup="false"
  android:fullBackupContent="false"
  android:dataExtractionRules="@xml/data_extraction_rules">
  <!-- singleTask so a share, or a shortcut, reaches the copy of the app that is
       already open instead of stacking a second one behind it. -->
  <activity
   android:name=".MainActivity"
   android:exported="true"
   android:launchMode="singleTask">
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
   <!-- Browsers and shop apps hand a link over as text/plain; a few send it as
        text/html instead, which is the same string with a tag around it. -->
   <intent-filter>
    <action android:name="android.intent.action.SEND"/>
    <category android:name="android.intent.category.DEFAULT"/>
    <data android:mimeType="text/plain"/>
    <data android:mimeType="text/html"/>
   </intent-filter>
   <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts"/>
  </activity>
  <!-- One figure in the notification shade, reachable without leaving whatever
       is on screen. Exported because Quick Settings binds it from the system
       process; the BIND permission is what keeps anything else out. -->
  <service
   android:name=".FlowPayTileService"
   android:exported="true"
   android:icon="@drawable/ic_tile"
   android:label="@string/tile_label"
   android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
   <intent-filter>
    <action android:name="android.service.quicksettings.action.QS_TILE"/>
   </intent-filter>
   <!-- A long press opens the app; a short press swaps which figure is shown. -->
   <meta-data
    android:name="android.service.quicksettings.ACTIVITY_NAME"
    android:value="com.flowpay.app.MainActivity"/>
  </service>
  <receiver
   android:name=".FlowPayWidgetReceiver"
   android:exported="false"
   android:label="FlowPay">
   <intent-filter>
    <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
   </intent-filter>
   <meta-data
    android:name="android.appwidget.provider"
    android:resource="@xml/flowpay_widget_info"/>
  </receiver>
 </application>
</manifest>
